# Copy to .env.local and fill in. Never commit .env.local.

# Application connection. Must be a NON-SUPERUSER role: Postgres superusers and
# table owners bypass Row Level Security, which would silently disable the
# approval-authority enforcement this prototype relies on.
DATABASE_URL=postgres://crm_app:CHANGE_ME@localhost:5432/crm_isam_dev

# Owner/superuser connection. Used only by bootstrap, migrate and seed scripts.
# The running application never uses this.
ADMIN_DATABASE_URL=postgres://YOUR_OS_USER@localhost:5432/crm_isam_dev

# HMAC key for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Password assigned to every seeded demo account. Demo data only — these accounts
# guard nothing but synthetic records.
DEMO_PASSWORD=demo1234
